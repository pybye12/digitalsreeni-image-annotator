QWidget {{
    background: {bg_surface};
    color: {text};
    font-family: "Segoe UI";
    font-size: {font_size}pt;
}}
QMainWindow, QWidget#studioRoot {{ background: {bg_canvas}; }}
QMenuBar {{ background: {bg_surface}; border-bottom: 1px solid {border}; padding: 1px 6px; }}
QMenuBar::item {{ background: {transparent}; padding: 5px 8px; }}
QMenuBar::item:selected, QMenu::item:selected {{ background: {bg_hover}; border-radius: 4px; }}
QMenu {{ background: {bg_elevated}; border: 1px solid {border}; padding: 5px; }}
QMenu::item {{ padding: 7px 24px 7px 10px; }}
QToolTip {{ background: {bg_elevated}; color: {text}; border: 1px solid {border_strong}; padding: 6px; }}
QWidget#topBar, QWidget#toolRail, QWidget#classPanel, QWidget#filmstripPanel {{ background: {bg_surface}; border: 1px solid {border}; }}
QWidget#topBar {{ border-width: 0 0 1px 0; }}
QWidget#toolRail {{ border-width: 0 1px 0 0; }}
QWidget#classPanel {{ border-width: 0 0 0 1px; }}
QWidget#filmstripPanel {{ border-width: 1px 0 0 0; }}
QWidget#canvasPanel, QScrollArea#canvasViewport, QScrollArea#canvasViewport > QWidget > QWidget {{ background: {bg_canvas}; border: 0; }}
QWidget#canvasHeader, QWidget#canvasFooter {{ background: {bg_canvas}; border: 0; }}
QLabel[uiRole="appTitle"] {{ font-size: 12pt; font-weight: 700; }}
QLabel[uiRole="section"] {{ color: {text_muted}; font-size: 8pt; font-weight: 700; }}
QLabel[uiRole="muted"] {{ color: {text_muted}; }}
QLabel[uiRole="subtle"] {{ color: {text_subtle}; }}
QLabel[uiRole="saved"] {{ color: {success}; }}
QLabel[uiRole="warning"] {{ color: {warning}; }}
QPushButton, QToolButton, QComboBox {{ background: {bg_elevated}; border: 1px solid {border}; border-radius: 6px; color: {text}; min-height: 28px; padding: 3px 9px; }}
QPushButton:hover, QToolButton:hover, QComboBox:hover {{ background: {bg_hover}; border-color: {border_strong}; }}
QPushButton:pressed, QToolButton:pressed {{ background: {accent_pressed}; }}
QPushButton:checked, QToolButton:checked {{ background: {accent}; border-color: {accent_hover}; }}
QPushButton:disabled, QToolButton:disabled, QComboBox:disabled {{ color: {text_subtle}; background: {bg_surface}; }}
QPushButton[buttonRole="primary"] {{ background: {accent}; border-color: {accent}; font-weight: 600; }}
QPushButton[buttonRole="primary"]:hover {{ background: {accent_hover}; }}
QPushButton[buttonRole="primary"]:disabled {{ background: {bg_surface}; border-color: {border}; color: {text_subtle}; }}
QPushButton[buttonRole="danger"] {{ color: {danger}; }}
QToolButton[rail="true"], QPushButton[rail="true"] {{ border: 0; border-radius: 8px; font-size: 15pt; padding: 0; min-height: 40px; }}
QListWidget, QTableWidget, QTextEdit, QLineEdit {{ background: {bg_surface}; border: 1px solid {border}; border-radius: 6px; outline: 0; }}
QListWidget::item {{ padding: 7px; border-radius: 4px; }}
QListWidget::item:hover {{ background: {bg_hover}; }}
QListWidget::item:selected {{ background: {accent_pressed}; color: {text}; }}
QListWidget#frameList {{ border: 0; border-radius: 0; background: {bg_surface}; }}
QListWidget#frameList::item {{ margin: 3px; padding: 4px; }}
QListWidget#frameList::item:selected {{ border: 2px solid {accent}; background: {bg_elevated}; }}
QWidget#emptyDropZone {{ background: {bg_canvas}; border: 2px dashed {border_strong}; border-radius: 12px; }}
QLabel#emptyTitle {{ font-size: 18pt; font-weight: 700; }}
QLabel#emptyHint {{ color: {text_muted}; }}
QWidget#trackingDrawer, QWidget#brightnessPopover {{ background: {bg_elevated}; border: 1px solid {border}; border-radius: 8px; }}
QSlider::groove:horizontal {{ height: 4px; background: {border}; border-radius: 2px; }}
QSlider::handle:horizontal {{ background: {accent}; width: 14px; margin: -5px 0; border-radius: 7px; }}
QProgressBar {{ background: {bg_elevated}; border: 0; border-radius: 3px; min-height: 6px; max-height: 6px; }}
QProgressBar::chunk {{ background: {accent}; border-radius: 3px; }}
QScrollBar:vertical {{ background: {bg_surface}; width: 8px; }}
QScrollBar::handle:vertical {{ background: {border_strong}; min-height: 28px; border-radius: 4px; }}
QScrollBar:horizontal {{ background: {bg_surface}; height: 8px; }}
QScrollBar::handle:horizontal {{ background: {border_strong}; min-width: 28px; border-radius: 4px; }}
